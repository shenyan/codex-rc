{
  "name": "codex-rc",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev:server": "bun --hot server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "bun server/index.ts",
    "start:ws": "CODEX_RC_INSTANCE=ws CODEX_RC_PORT=9886 CODEX_RC_CODEX_TRANSPORT=ws CODEX_RC_CODEX_WS_URL=ws://127.0.0.1:9877 bun server/index.ts",
    "start:both": "bash -c 'bun server/index.ts & CODEX_RC_INSTANCE=ws CODEX_RC_PORT=9886 CODEX_RC_CODEX_TRANSPORT=ws CODEX_RC_CODEX_WS_URL=ws://127.0.0.1:9877 bun server/index.ts; kill %1 2>/dev/null'",
    "test": "bun test tests/transport.test.ts tests/recovery.test.ts",
    "test:e2e": "npx playwright test"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.27.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/bun": "latest",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
